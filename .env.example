# MAA SHARADA ENTERPRISES - Environment Example
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# SQLite Database Location
# In Local Development: ./database/shop.db
# In Railway (with Persistent Volume mounted at /database): /database/shop.db
DATABASE_PATH=./database/shop.db

# Admin Authentication Secrets (Configure securely in Railway Environment Variables)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password
JWT_SECRET=your_jwt_secret_key_here

# Configurable Shop Information
SHOP_PHONE_NUMBER=
SHOP_EMAIL=contact@maasharada.com
SHOP_OWNER=ARUN KUMAR PATEL
SHOP_ADDRESS=Gazipur road,Nearby Shahpur petrol pump,Panihari chaubepur Varanasi
SHOP_TAGLINE=BATTERY • INVERTER • SOLAR • ELECTRICAL SOLUTIONS
MAPS_QUERY=Gazipur road,Nearby Shahpur petrol pump,Panihari chaubepur Varanasi
