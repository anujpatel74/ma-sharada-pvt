# MAA SHARADA ENTERPRISES - Environment Example
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# SQLite Database Location
# In Local Development: ./database/shop.db
# In Railway (with Persistent Volume mounted at /database): /database/shop.db
DATABASE_PATH=./database/shop.db

# Admin Authentication Secrets (Configure securely in Railway Environment Variables)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password
JWT_SECRET=your_jwt_secret_key_here

# Persistent Image Storage for Homepage Slider
# OPTION 1 (Recommended for Railway): Cloudinary Free Cloud Storage (https://cloudinary.com)
# When configured, all slider uploads persist permanently in the cloud.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# OPTION 2: Persistent Volume Mount Path (if using attached volume on Railway)
# UPLOADS_PATH=/database/uploads/slider

# Configurable Shop Information
SHOP_PHONE_NUMBER=
SHOP_EMAIL=contact@maasharada.com
SHOP_OWNER=ARUN KUMAR PATEL
SHOP_ADDRESS=Gazipur road,Nearby Shahpur petrol pump,Panihari chaubepur Varanasi
SHOP_TAGLINE=BATTERY • INVERTER • SOLAR • ELECTRICAL SOLUTIONS
MAPS_QUERY=Gazipur road,Nearby Shahpur petrol pump,Panihari chaubepur Varanasi
